# ─── Database ────────────────────────────────────
# Supabase (PostgreSQL) — primary database
# Get these from: https://supabase.com/dashboard/project/<your-ref>/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://iprauvltxxmigxptmned.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""  # server only — bypasses RLS

# ─── Storage (Supabase S3-compatible) ────────────────
# Get these from: https://supabase.com/dashboard/project/<your-ref>/settings/storage
S3_ENDPOINT="https://iprauvltxxmigxptmned.storage.supabase.co/storage/v1/s3"
S3_REGION="us-east-1"
S3_BUCKET="uploads"
S3_ACCESS_KEY=""  # from Supabase Dashboard → Settings → Storage → S3 Connection
S3_SECRET_KEY=""  # click "Reveal" to see it
S3_FORCE_PATH_STYLE="false"

# For PostgreSQL direct connection (Prisma, raw SQL) — use the POOLER hostname
# (not the direct db.*.supabase.co which is IPv6-only and unreachable from Vercel/Render)
# DATABASE_URL="postgresql://postgres.iprauvltxxmigxptmned:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ─── NextAuth ───────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ─── AI Providers ───────────────────────────────────────────
# Google AI Studio (Gemini) — for text generation, storyboard, script analysis
# Get your key from: https://aistudio.google.com/apikey
GOOGLE_AI_STUDIO_KEY=""

# Video providers (paid — see AI_PROVIDERS.md for details)
RUNWAY_API_KEY=""
PIKA_API_KEY=""
LUMA_API_KEY=""
REPLICATE_API_TOKEN=""

# Image providers
OPENAI_API_KEY=""
STABILITY_API_KEY=""

# Voice providers
ELEVENLABS_API_KEY=""

# Translation
DEEPL_API_KEY=""

# ─── Storage (S3-compatible) ────────────────────
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="promptreel"
S3_REGION="us-east-1"

# ─── Queue (Redis + BullMQ) ──────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Stripe (billing) ───────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# ─── App config ─────────────────────────────────
APP_URL="http://localhost:3000"
APP_NAME="PromptReel"
