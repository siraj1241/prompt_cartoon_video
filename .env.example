# ─── Database ────────────────────────────────────
# Option A: Supabase (recommended — already wired up)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""  # server only — bypasses RLS

# Option B: Local SQLite (Prisma, dev only)
# DATABASE_URL="file:./dev.db"

# Option C: PostgreSQL via Prisma (alternative)
# DATABASE_URL="postgresql://user:password@localhost:5432/promptreel"

# ─── NextAuth ───────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ─── AI Provider API Keys (server-side only) ────
# Video providers (paid)
RUNWAY_API_KEY=""
PIKA_API_KEY=""
LUMA_API_KEY=""
REPLICATE_API_TOKEN=""

# Image providers
OPENAI_API_KEY=""
STABILITY_API_KEY=""

# Voice providers
ELEVENLABS_API_KEY=""

# Translation
DEEPL_API_KEY=""

# ─── Storage (S3-compatible) ────────────────────
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="promptreel"
S3_REGION="us-east-1"

# ─── Queue (Redis + BullMQ) ──────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Stripe (billing) ───────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# ─── App config ─────────────────────────────────
APP_URL="http://localhost:3000"
APP_NAME="PromptReel"
